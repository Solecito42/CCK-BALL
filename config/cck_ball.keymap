#define ZMK_POINTING_DEFAULT_MOVE_VAL 1000
#define ZMK_POINTING_DEFAULT_SCRL_VAL 12

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };
&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <0>;
    time-to-max-speed-ms = <300>;
    delay-ms = <0>;
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_vertical_encoder: scroll_vertical_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
        tap-ms = <100>;
    };

    scroll_horizontal_encoder: scroll_horizontal_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_LEFT>, <&msc SCRL_RIGHT>;
        tap-ms = <100>;
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            bindings = <

// LEFT OUTER                                RIGHT OUTER
&kp ESC   &kp N1 &kp N2 &kp N3 &kp N4 &kp N5    &kp N6 &kp N7 &kp N8 &kp N9 &kp N0 &kp DEL
&kp TAB   &kp Q  &kp W  &kp E  &kp R  &kp T     &kp Y  &kp U  &kp I  &kp O  &kp P  &kp LC(LS(S))
&kp C_MUTE &kp A &kp S  &kp D  &kp F  &kp G     &kp H  &kp J  &kp K  &kp L  &kp SEMI &kp LG(I)
&kp LSHFT &kp Z  &kp X  &kp C  &kp V  &kp B     &kp N  &kp M  &kp COMMA &kp DOT &kp UP &kp LG(K)

// THUMBS (YOUR EXACT DESIGN)
&mt LCTRL ESC   &lt 1 BSPC   &mt LALT DEL      &mt LGUI TAB   &lt 2 SPACE   &mt LSHFT ENTER

            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        SYM_NUM {
            bindings = <

&kp F12 &kp F1 &kp F2 &kp F3 &kp F4 &kp F5     &kp F6 &kp F7 &kp F8 &kp F9 &kp F10 &kp F11

&trans  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT   &trans &kp N7 &kp N8 &kp N9 &trans &trans
&trans  &kp CARET &kp AMPS &kp ASTRK &kp LPAR &kp RPAR &trans &kp N4 &kp N5 &kp N6 &trans &trans
&trans  &kp MINUS &kp EQUAL &kp LBKT &kp RBKT &kp GRAVE &trans &kp N1 &kp N2 &kp N3 &trans &trans
&trans  &trans &trans &trans &trans &trans     &trans &kp N0 &kp DOT &trans &trans &trans

// thumbs stay functional but not overridden
&trans &trans &trans   &trans &trans &trans

            >;
        };

        NAV {
            bindings = <

&trans &bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_SEL 4   &trans &trans &trans &trans &trans &bt BT_CLR

&trans &trans &trans &trans &trans &trans     &trans &kp HOME &kp UP &kp END &kp PG_UP &bt BT_CLR_ALL
&trans &trans &trans &trans &trans &trans     &trans &kp LEFT &kp DOWN &kp RIGHT &kp PG_DN &bt BT_NXT
&trans &kp LC(Z) &kp LC(X) &kp LC(C) &kp LC(V) &trans   &trans &trans &trans &trans &trans &trans

&trans &trans &trans &trans &trans &trans

            >;
        };

        scroll-layers {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN &inc_dec_kp PG_UP PG_DN>;
        };

        snipe-layers {
            bindings = <
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans &trans
            >;
            sensor-bindings = <&scroll_vertical_encoder>, <&scroll_horizontal_encoder>;
        };
    };
};
